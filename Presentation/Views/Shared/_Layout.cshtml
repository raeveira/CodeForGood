<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CodeForGoodSalesToDev</title>
    @await RenderSectionAsync("Head", required: false)
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
</head>
<body style="overflow: hidden;">
    @* header *@
    <header class="PageHeader">
        <div class="HeaderLogo">
            <img src="~/images/codeforgood.svg" alt="Code for Good Logo" style="height: 60px;" />
            <h1>Code for Good</h1>
        </div>
        
        
        @if (User.Identity?.IsAuthenticated == true)
        {
            <form method="post" asp-controller="Account" asp-action="Logout" class="LogoutForm">
                <button type="submit" class="LogoutButton">Sign out</button>
            </form>
        }
    </header>
    @RenderBody()
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
