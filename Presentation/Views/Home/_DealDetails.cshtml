@using Presentation.Models
@model DealDetailsViewModel
@{
    Guid dealId = Model.Deal.Id;
    IEnumerable<Application.Requirements.RequirementResponseDto> requirementsOfDeal = Model.Requirements;
    Application.Requirements.RequirementResponseDto? selectedRequirement = Model.SelectedRequirement;
    IEnumerable<Application.Messages.MessageResponseDto> selectedMessages = Model.Messages;
    
    bool ShowCreateRequirementModal = ViewData["ShowCreateRequirementModal"] as bool? ?? false;
    bool ShowUpdateRequirementModal = ViewData["ShowUpdateRequirementModal"] as bool? ?? false;
    bool ShowUpdateDealModal = ViewData["ShowUpdateDealModal"] as bool? ?? false;
}

@if (ShowCreateRequirementModal)
{
    <partial name="_CreateRequirementModal" model="Model" />
}
@if (ShowUpdateRequirementModal)
{
    <partial name="_UpdateRequirementModal" model="Model" />
}
@if (ShowUpdateDealModal)
{
    <partial name="_UpdateDealModal" model="Model" />
}

<div class="DealDetails">
    <div class="DealContent">
        @if (selectedRequirement is null)
        {
            <div class="RequirementsListView">
                <div class="RequirementsListHeader">
                    <h2>Requirements</h2>
                    @if (User.IsInRole(role: "Sales"))
                    {
                        <form method="post" asp-action="OpenCreateRequirementModal" style="display: inline;">
                            <input type="hidden" name="dealId" value="@dealId" />
                            <button type="submit" class="AddRequirementBtn">
                                <img src="~/images/Plus.svg" alt="Add Requirement" style="height: 16px;" />
                                <span>Add Requirement</span>
                            </button>
                        </form>
                    }
                </div>
                <div class="RequirementsListGrid">
                    @foreach (Application.Requirements.RequirementResponseDto requirement in requirementsOfDeal)
                    {
                        <a asp-action="Index" asp-route-dealId="@dealId" asp-route-requirementId="@requirement.Id" class="RequirementCard" data-requirement-id="@requirement.Id" data-attention-events="@System.Text.Json.JsonSerializer.Serialize(Model.RequirementAttention[requirement.Id].Events)" data-attention-pending="@Model.RequirementAttention[requirement.Id].PendingDeadline.ToString().ToLowerInvariant()">
                            <p class="RequirementTitle">@requirement.Title</p>
                            <span class="AttentionBadge" hidden>Needs attention</span>
                            <p class="RequirementDescription">@requirement.Description</p>
                            
                            <div class="RequirementPills">
                                <div class="RequirementPill">@requirement.Type</div>
                                <div class="RequirementPill">@requirement.Priority</div>
                            </div>
                            
                            <p class="RequirementModulesHeading">Bedrijfsmodule(s)</p>
                            <p class="RequirementModules">@string.Join(", ", requirement.Modules)</p>
                        </a>
                    }
                </div>
            </div>
        }
        
        @if (selectedRequirement is not null)
        {
            <div class="DealChat" data-current-requirement-events="@System.Text.Json.JsonSerializer.Serialize(Model.RequirementAttention[selectedRequirement.Id].Events)">
                <div class="DealTitle">
                    <div class="DealTitleColumn">
                        <a asp-action="Index" asp-route-dealId="@dealId" class="BackButton">
                            <span>←</span>
                        </a>
                        <div>
                            <h2>@selectedRequirement.Title</h2>
                            <p class="RequirementDescriptionSmall">@selectedRequirement.Description</p>
                        </div>
                    </div>
                    @if (User.IsInRole("Sales"))
                    {
                        <div class="DealTitleColumn">
                            <form method="post" asp-action="OpenUpdateRequirementModal" asp-route-dealId="@dealId" asp-route-requirementId="@selectedRequirement.Id">
                                <button class="RequirementActionBtn" type="submit">Update Requirement</button>
                                <button class="RequirementActionBtn" type="submit" formaction="@Url.Action(action: "DeleteRequirement", new { dealId = dealId, requirementId = selectedRequirement.Id })" style="color: Red; margin-left: 0.5rem;" >Delete Requirement</button>
                            </form>
                        </div>                
                    }
                </div>
                
                <div class="ThreadHeader">
                    <strong>@selectedRequirement.Type</strong>
                    <span>@selectedRequirement.Priority</span>
                </div>
                
                <div class="MessageList">
                    @foreach (Application.Messages.MessageResponseDto chatMessage in selectedMessages)
                    {
                        <div class="ChatMessage @(chatMessage.Author.Equals(value: "Sales", comparisonType: StringComparison.Ordinal) ? "FromSales" : "FromDeveloper")">
                            <div class="MessageHeader">
                                <strong>@chatMessage.Author</strong>
                                <time datetime="@chatMessage.SentAt.ToString(format: "s")">@chatMessage.SentAt.ToString("dd MMM yyyy, HH:mm", System.Globalization.CultureInfo.InvariantCulture)</time>
                            </div>
                            <p>@chatMessage.Text</p>
                            @if (chatMessage.RequestedDeadline is not null)
                            {
                                <p>@(chatMessage.DeadlineAdapted ? "Deadline adapted" : "Deadline request pending")</p>
                                @if (!chatMessage.DeadlineAdapted && User.IsInRole("Sales"))
                                {
                                    <form method="post" asp-action="AdaptDeadline">
                                        <input type="hidden" name="dealId" value="@dealId" />
                                        <input type="hidden" name="requirementId" value="@selectedRequirement.Id" />
                                        <input type="hidden" name="messageId" value="@chatMessage.Id" />
                                        <button type="submit" class="ModalBtn ModalSubmitBtn">Adapt</button>
                                    </form>
                                }
                            }
                        </div>
                    }
                    @if (!selectedMessages.Any())
                    {
                        <p class="EmptyThread">No messages yet for this requirement.</p>
                    }
                </div>
                
                @if (TempData["ChatError"] is string chatError)
                {
                    <p class="text-danger" role="alert">@chatError</p>
                }
                <form method="post" asp-action="SendMessage">
                    <input type="hidden" name="dealId" value="@dealId" />
                    <input type="hidden" name="requirementId" value="@selectedRequirement.Id" />
                    <div class="InputField">
                        @if (User.IsInRole("Developer"))
                        {
                            <div class="SlashCommandPopup" id="slashCommandPopup" role="group" aria-label="Available chat commands" hidden>
                                <button type="button" class="SlashCommandOption" id="deadlineCommand">
                                    <strong>/deadline</strong>
                                    <span>Request a new deadline</span>
                                    <small>YYYY-MM-DD</small>
                                </button>
                            </div>
                            <div class="DeadlineComposer" id="deadlineComposer" hidden>
                                <span class="DeadlineCommandName">/deadline</span>
                                <label class="visually-hidden" for="requestedDeadline">Requested deadline</label>
                                <input id="requestedDeadline" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)" max="9999-12-31" required disabled />
                                <button type="button" class="DeadlineCancel" id="cancelDeadline" aria-label="Cancel deadline request">×</button>
                            </div>
                        }
                        <textarea name="messageText" rows="1" placeholder="Type a message..." oninput="this.style.height='auto'; this.style.height=this.scrollHeight+'px'"></textarea>
                        <button type="submit">Send</button>
                    </div>
                </form>
            </div>
        }
    </div>

    <div class="DealInfo">
        <div class="ExtraInfo">
            <h3>Deal Information</h3>
             @if (User.IsInRole(role: "Sales"))
            {
                <div class="DealTitleColumn">
                    <form method="post" asp-action="OpenUpdateDealModal" asp-route-dealId="@dealId" asp-route-requirementId="@selectedRequirement?.Id">
                        <button class="DealActionBtn" type="submit">Update Deal</button>
                        <button class="DealActionBtn" type="submit" formaction="@Url.Action(action: "DeleteDeal", new { dealId = dealId })" style="color: Red; margin-left: 0.5rem;" >Delete Deal</button>
                    </form>
                </div>                
            }
            <p><strong>Status:</strong> @Model.Deal.Status</p>
            <p><strong>Expected end date:</strong> @Model.Deal.EndDate.ToString("dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture)</p>
            <p><strong>Created at:</strong> @Model.Deal.CreatedAt.ToString("HH:mm - dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture)</p>
        </div>
        
        <div class="Divider"></div>
        <div class="CustomerName">
            <strong>Customer:</strong>
            <p>@Model.Deal.Customer</p>
        </div>
    
        <div class="Divider"></div>
        
        <div class="DealDescription">
            <strong>Description:</strong>
            <p>@Model.Deal.Description</p>
        </div>

        @if (selectedRequirement is not null)
        {
            <div class="Divider"></div>
            <div class="RequirementModulesSection">
                <h5><strong>Requirement Info:</strong></h5>
                <p><strong>Deadline:</strong> @(selectedRequirement.Deadline?.ToString("dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture) ?? "Not set")</p>
                <div class="ModulesHeader">
                    <strong>Company Module(s):</strong>
                    @if (User.IsInRole("Developer"))
                    {
                        <button type="button" class="AddModuleBtn" onclick="document.getElementById('addModuleModal').showModal()">+</button>
                    }
                </div>
                    
                <div class="ModulesList">
                    @foreach (var module in selectedRequirement.Modules)
                    {
                        <div class="ModuleTag">
                            <span>@module</span>
                            @if (User.IsInRole("Developer"))
                            {
                                <form method="post" asp-action="RemoveModule" style="display: inline; margin-left: 0.5rem;">
                                    <input type="hidden" name="requirementId" value="@selectedRequirement.Id" />
                                    <input type="hidden" name="dealId" value="@dealId" />
                                    <input type="hidden" name="module" value="@module" />
                                    <button type="submit" class="RemoveModuleBtn" title="Remove module">×</button>
                                </form>
                            }
                        </div>
                    }
                </div>
                
                @if (User.IsInRole(role: "Developer"))
                {
                    <dialog id="addModuleModal" class="Modal">
                        <div class="ModalContent">
                            <div class="ModalHeader">
                                <h3>Add New Module</h3>
                                <button type="button" class="ModalCloseBtn" onclick="document.getElementById('addModuleModal').close()">×</button>
                            </div>
                            
                            <form method="post" asp-action="AddModule" class="ModalForm">
                                <input type="hidden" name="requirementId" value="@selectedRequirement.Id" />
                                <input type="hidden" name="dealId" value="@dealId" />
                                
                                <div class="FormGroup">
                                    <label for="moduleName">Module Name:</label>
                                    <input type="text" id="moduleName" name="moduleName" placeholder="Enter module name..." class="FormInput" required />
                                </div>
                                
                                <div class="ModalActions">
                                    <button type="button" class="ModalBtn ModalCancelBtn" onclick="document.getElementById('addModuleModal').close()">Cancel</button>
                                    <button type="submit" class="ModalBtn ModalSubmitBtn">Add Module</button>
                                </div>
                            </form>
                        </div>
                    </dialog>
                }
            </div>
        }
    </div>
</div>

