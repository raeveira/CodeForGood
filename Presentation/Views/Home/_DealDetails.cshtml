@using Presentation.Models
@model DealDetailsViewModel
@{
    Guid dealId = Model.Deal.Id;
    IEnumerable<Application.Requirements.RequirementResponseDto> requirementsOfDeal = Model.Requirements;
    Application.Requirements.RequirementResponseDto? selectedRequirement = Model.SelectedRequirement;
    IEnumerable<Application.Messages.MessageResponseDto> selectedMessages = Model.Messages;
}

<div class="DealDetails">
    <div class="DealContent">
        @if (selectedRequirement is null)
        {
            <div class="RequirementsListView">
                <h2>Requirements</h2>
                <div class="RequirementsListGrid">
                    @foreach (Application.Requirements.RequirementResponseDto requirement in requirementsOfDeal)
                    {
                        <a asp-action="Index" asp-route-dealId="@dealId" asp-route-requirementId="@requirement.Id" class="RequirementCard">
                            <p class="RequirementTitle">@requirement.Title</p>
                            <p class="RequirementDescription">@requirement.Description</p>
                            
                            <div class="RequirementPills">
                                <div class="RequirementPill">@requirement.Type</div>
                                <div class="RequirementPill">@requirement.Priority</div>
                            </div>
                            
                            <p class="RequirementModulesHeading">Bedrijfsmodule(s)</p>
                            <p class="RequirementModules">@string.Join(", ", requirement.Modules)</p>
                        </a>
                    }
                </div>
            </div>
        }
        
        @if (selectedRequirement is not null)
        {
            <div class="DealChat">
                <div class="DealTitle">
                    <a asp-action="Index" asp-route-dealId="@dealId" class="BackButton">
                        <span>←</span>
                    </a>
                    <div>
                        <h2>@selectedRequirement.Title</h2>
                        <p class="RequirementDescriptionSmall">@selectedRequirement.Description</p>
                    </div>
                </div>
                
                <div class="ThreadHeader">
                    <strong>@selectedRequirement.Type</strong>
                    <span>@selectedRequirement.Priority</span>
                </div>
                
                <div class="MessageList">
                    @foreach (Application.Messages.MessageResponseDto chatMessage in selectedMessages)
                    {
                        <div class="ChatMessage @(chatMessage.Author == "Sales" ? "FromSales" : "FromDeveloper")">
                            <div class="MessageHeader">
                                <strong>@chatMessage.Author</strong>
                                <time datetime="@chatMessage.SentAt.ToString(format: "s")">@chatMessage.SentAt.ToString("dd MMM yyyy, HH:mm", System.Globalization.CultureInfo.InvariantCulture)</time>
                            </div>
                            <p>@chatMessage.Text</p>
                        </div>
                    }
                    @if (!selectedMessages.Any())
                    {
                        <p class="EmptyThread">No messages yet for this requirement.</p>
                    }
                </div>
                
                <form method="post" asp-action="SendMessage">
                    <input type="hidden" name="dealId" value="@dealId" />
                    <input type="hidden" name="requirementId" value="@selectedRequirement.Id" />
                    <div class="InputField">
                        <textarea name="messageText" rows="1" placeholder="Type a message..." oninput="this.style.height='auto'; this.style.height=this.scrollHeight+'px'"></textarea>
                        <button type="submit">Send</button>
                    </div>
                </form>
            </div>
        }
    </div>

    <div class="DealInfo">
        <div class="ExtraInfo">
            <p><strong>Status:</strong> @Model.Deal.Status</p>
            <p><strong>Expected end date:</strong> @Model.Deal.EndDate.ToString("dd-MM-yyyy")</p>
        </div>
        
        <div class="Divider"></div>
        <div class="CustomerName">
            <strong>Customer:</strong>
            <p>@Model.Deal.Customer</p>
        </div>
    
        <div class="Divider"></div>
        
        <div class="DealDescription">
            <strong>Description:</strong>
            <p>@Model.Deal.Description</p>
        </div>

        @if (selectedRequirement is not null)
        {
            <div class="Divider"></div>
            <div class="RequirementModulesSection">
                <strong>Bedrijfsmodule(s):</strong>
                <p class="RequirementModulesList">@string.Join(", ", selectedRequirement.Modules)</p>
            </div>
        }
    </div>
</div>

