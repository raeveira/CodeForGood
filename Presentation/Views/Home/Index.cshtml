@model HomeViewModel
@{
    ViewData["Title"] = "Code for Good - Home";
}

<main class="HomeMain">
    <div class="Sidebar">
        @if (User.IsInRole("Sales"))
        {
            <h3>Sales Environment</h3>
        }
        else if (User.IsInRole("Developer"))
        {
            <h3>Developer Environment</h3>
        }

        <div class="DealHeader">
            <h2>Deals</h2>
            
            @if (User.IsInRole("Sales"))
            {
                <button class="AddDealBtn">
                    <img src="~/images/Plus.svg" alt="Add Deal" style="height: 16px;" />
                </button>
            }
        </div>
            
        <div class="Divider"></div>
        
        @* Deals Cards *@
        <div class="DealsCards">
            @foreach (var deal in Model.Deals)
            {
                <a asp-action="Index" asp-route-dealId="@deal.Id" class="DealCard @(deal.Id == Model.SelectedDeal?.Id ? "Selected" : "")">
                    <div class="DealHeading">
                        <div class="DealHeadingLeft">
                            <h4>@deal.Title</h4>
                            <p>@deal.Customer</p>
                        </div>

                        <div class="DealHeadingRight">
                            <p>@deal.Status</p>
                        </div>
                    </div>

                    <div class="Divider"></div>

                    <p class="DealBodyHeading">Expected end date</p>
                    <p class="DealBodyDates">@deal.EndDate.ToString("dd-MM-yyyy", System.Globalization.CultureInfo.InvariantCulture)</p>
                </a>
            }
        </div>
    </div>

    <div class="HomeContent">
        @if (Model.SelectedDeal is null)
        {
            <p>No deal selected.</p>
        }
        
        @if (Model.SelectedDeal is not null) 
        { 
            <partial name="_DealDetails" model="new DealDetailsViewModel(Model.SelectedDeal, Model.RequirementsForDeal, Model.SelectedRequirement, Model.MessagesForRequirement)" />
        }
        
    </div>
    
</main>
